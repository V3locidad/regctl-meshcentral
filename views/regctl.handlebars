<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>regctl — Registre Windows</title>
<style>
  html, body { height: 100%; margin: 0; font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; font-size: 13px; color: #222; }
  body { display: flex; flex-direction: column; height: 100vh; }
  header { padding: 8px 12px; border-bottom: 1px solid #ddd; background: #fafafa; display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  header h1 { margin: 0; font-size: 14px; font-weight: 600; }
  header .grow { flex: 1; }
  header input, header button { font-size: 12px; padding: 3px 6px; }
  main { display: flex; flex: 1; min-height: 0; }
  .pane { overflow: auto; padding: 0; }
  #agents { width: 260px; border-right: 1px solid #ddd; display: flex; flex-direction: column; }
  #agentsList { overflow: auto; flex: 1; }
  #agentsBar { padding: 6px; border-bottom: 1px solid #eee; background: #f7f7f7; display: flex; gap: 4px; align-items: center; }
  #agentsBar input { flex: 1; }
  #agentsFoot { padding: 6px 8px; border-top: 1px solid #eee; background: #f7f7f7; font-size: 11px; color: #555; }
  .ag { padding: 4px 8px; border-bottom: 1px solid #f3f3f3; display: flex; align-items: center; gap: 6px; cursor: pointer; }
  .ag:hover { background: #f4f8fc; }
  .ag.active { background: #d6e9ff; }
  .ag .dot { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; }
  .ag .dot.on { background: #2bb673; }
  .ag .dot.off { background: #cd3a3a; }
  .ag .name { flex: 1; font-size: 12px; }
  .ag .mesh { color: #888; font-size: 10px; }
  .ag input[type=checkbox] { flex: 0 0 auto; }
  #tree { width: 36%; border-right: 1px solid #ddd; }
  #values { flex: 1; }
  .node { padding: 1px 4px 1px 0; cursor: pointer; white-space: nowrap; font-family: Menlo, Consolas, monospace; font-size: 12px; }
  .node .twist { display: inline-block; width: 12px; color: #888; }
  .node.selected > .label { background: #d6e9ff; }
  .node .label:hover { background: #eef4fb; }
  .children { padding-left: 14px; }
  .err { color: #b00; font-size: 11px; padding: 4px; white-space: pre-wrap; }
  .toolbar { padding: 6px 8px; border-bottom: 1px solid #eee; background: #f7f7f7; display: flex; gap: 6px; align-items: center; font-size: 12px; }
  .toolbar .path { font-family: Menlo, Consolas, monospace; flex: 1; padding: 2px 4px; background: #fff; border: 1px solid #ddd; border-radius: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  th, td { padding: 4px 6px; border-bottom: 1px solid #f0f0f0; text-align: left; vertical-align: top; }
  th { background: #f4f4f4; position: sticky; top: 0; font-weight: 600; }
  tr.row:hover { background: #fafafa; cursor: pointer; }
  td.data { font-family: Menlo, Consolas, monospace; word-break: break-all; max-width: 400px; }
  .badge { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 10px; background: #e2e3e5; color: #383d41; }
  .modalBg { position: fixed; inset: 0; background: rgba(0,0,0,.35); display: flex; align-items: center; justify-content: center; z-index: 10; }
  .modal { background: #fff; padding: 16px 20px; border-radius: 6px; min-width: 420px; max-width: 90%; max-height: 90%; overflow: auto; }
  .modal h3 { margin: 0 0 10px 0; font-size: 14px; }
  .modal label { display: block; margin: 6px 0 2px; font-size: 12px; color: #555; }
  .modal input, .modal select, .modal textarea { width: 100%; box-sizing: border-box; padding: 4px 6px; font-size: 12px; font-family: inherit; }
  .modal textarea { font-family: Menlo, Consolas, monospace; min-height: 80px; }
  .modal .actions { margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end; }
  .empty { color: #aaa; font-style: italic; padding: 12px; text-align: center; }
  .danger { background: #fbe9e7; color: #8a2a17; border: 1px solid #f5c2b8; padding: 3px 8px; border-radius: 3px; cursor: pointer; }
  button { padding: 3px 8px; cursor: pointer; }
  button[disabled] { opacity: 0.5; cursor: not-allowed; }
  #spinner { display: none; color: #888; font-size: 11px; margin-left: 6px; }
  #spinner.on { display: inline; }
  .batchTag { background: #fff3cd; color: #856404; padding: 1px 6px; border-radius: 3px; font-size: 11px; }
  .batchResults { max-height: 220px; overflow: auto; border: 1px solid #eee; padding: 6px; font-family: Menlo, Consolas, monospace; font-size: 11px; margin-top: 8px; }
  .batchResults .ok { color: #2bb673; }
  .batchResults .ko { color: #cd3a3a; }
</style>
</head>
<body>

<header>
  <h1>Registre — regctl</h1>
  <span id="spinner">⟳</span>
  <span id="batchTag" class="batchTag" style="display:none"></span>
  <div class="grow"></div>
  <button id="refreshAgents" title="Recharger la liste des postes">↻ Postes</button>
  <button id="refreshTree" title="Recharger l'arbre">↻ Arbre</button>
</header>

<main>
  <div id="agents" class="pane">
    <div id="agentsBar">
      <input id="agentFilter" placeholder="Filtrer…">
      <button id="agentSelAll" title="Tout cocher / décocher">⊞</button>
    </div>
    <div id="agentsList"><div class="empty">Chargement…</div></div>
    <div id="agentsFoot"><span id="agentsStats">0 postes</span></div>
  </div>

  <div id="tree" class="pane">
    <div class="empty">Clique sur un poste à gauche pour parcourir son registre.</div>
  </div>

  <div id="values" class="pane" style="padding:0">
    <div class="toolbar">
      <span class="path" id="curPath">—</span>
      <button id="newValBtn" disabled>+ Valeur</button>
      <button id="newKeyBtn" disabled>+ Sous-clé</button>
      <button id="delKeyBtn" class="danger" disabled>Suppr. clé</button>
    </div>
    <div id="valuesBody" style="padding:6px">
      <div class="empty">Sélectionne une clé pour voir ses valeurs.</div>
    </div>
  </div>
</main>

<script>
'use strict';
function $(id) { return document.getElementById(id); }
function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c];
  });
}
function setBusy(on) { $('spinner').classList.toggle('on', !!on); }

function api(action, params, body) {
  var qs = 'action=' + encodeURIComponent(action);
  if (params) Object.keys(params).forEach(function (k) {
    qs += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
  });
  if (body) qs += '&payload=' + encodeURIComponent(JSON.stringify(body));
  return fetch('/pluginadmin.ashx?pin=regctl&' + qs, { credentials: 'include' })
    .then(function (r) { return r.json(); });
}

// dispatch + long-polling. Renvoie une promesse résolue avec result.data.
function callAgent(action, body) {
  setBusy(true);
  return api(action, null, body).then(function (r) {
    if (!r || !r.ok) {
      setBusy(false);
      throw new Error((r && r.error) || 'dispatch KO');
    }
    var dispatchId = r.dispatchId;
    var tries = 0;
    return new Promise(function (resolve, reject) {
      var poll = function () {
        tries++;
        api('pollResult', { dispatchId: dispatchId }).then(function (p) {
          if (p.ready) {
            setBusy(false);
            if (p.result && p.result.ok) resolve(p.result.data);
            else reject(new Error((p.result && p.result.error) || 'erreur agent'));
          } else if (p.unknown || tries > 4) {
            setBusy(false);
            reject(new Error(p.unknown ? 'dispatch perdu' : 'timeout'));
          } else poll();
        }).catch(function (e) { setBusy(false); reject(e); });
      };
      poll();
    });
  });
}

// --- Agents ---------------------------------------------------------------

var agents = [];
var activeNodeId = null;       // poste en cours de navigation (arbre)
var checkedNodes = {};         // ensemble des postes cochés pour batch ops

function loadAgents() {
  api('agents').then(function (r) {
    agents = r.agents || [];
    renderAgents();
    updateBatchTag();
  });
}

function renderAgents() {
  var q = ($('agentFilter').value || '').toLowerCase().trim();
  var filtered = agents.filter(function (a) {
    return !q || a.name.toLowerCase().indexOf(q) !== -1 || (a.mesh || '').toLowerCase().indexOf(q) !== -1;
  });
  if (!filtered.length) {
    $('agentsList').innerHTML = '<div class="empty">Aucun poste.</div>';
    $('agentsStats').textContent = '0 / ' + agents.length;
    return;
  }
  $('agentsList').innerHTML = filtered.map(function (a) {
    var actCls = (a.id === activeNodeId ? ' active' : '');
    var checked = checkedNodes[a.id] ? ' checked' : '';
    var dot = a.online ? 'on' : 'off';
    return '<div class="ag' + actCls + '" data-id="' + escapeHtml(a.id) + '">'
         +   '<input type="checkbox" class="chk"' + checked + (a.online ? '' : ' disabled') + '>'
         +   '<span class="dot ' + dot + '" title="' + (a.online ? 'En ligne' : 'Hors ligne') + '"></span>'
         +   '<span class="name">' + escapeHtml(a.name) + '</span>'
         +   '<span class="mesh">' + escapeHtml(a.mesh) + '</span>'
         + '</div>';
  }).join('');
  var on = filtered.filter(function (a) { return a.online; }).length;
  $('agentsStats').textContent = filtered.length + ' / ' + agents.length + ' postes · ' + on + ' en ligne';

  [].slice.call(document.querySelectorAll('#agentsList .ag')).forEach(function (row) {
    var id = row.getAttribute('data-id');
    var chk = row.querySelector('.chk');
    chk.onchange = function () {
      if (chk.checked) checkedNodes[id] = true; else delete checkedNodes[id];
      updateBatchTag();
    };
    chk.onclick = function (ev) { ev.stopPropagation(); };
    row.onclick = function () {
      var a = agents.find(function (x) { return x.id === id; });
      if (!a || !a.online) return;
      activeNodeId = id;
      renderAgents();
      resetBrowser();
      renderRoots();
    };
  });
}

function updateBatchTag() {
  var n = Object.keys(checkedNodes).length;
  var tag = $('batchTag');
  if (n <= 1) { tag.style.display = 'none'; return; }
  tag.style.display = '';
  tag.textContent = 'Batch : ' + n + ' postes cochés';
}

$('agentFilter').oninput = renderAgents;
$('refreshAgents').onclick = loadAgents;
$('agentSelAll').onclick = function () {
  var any = Object.keys(checkedNodes).length > 0;
  checkedNodes = {};
  if (!any) agents.filter(function (a) { return a.online; }).forEach(function (a) { checkedNodes[a.id] = true; });
  renderAgents();
  updateBatchTag();
};

// --- Tree -----------------------------------------------------------------

var ROOTS = ['HKLM', 'HKCU', 'HKCR', 'HKU', 'HKCC'];
var selectedPath = null;
var selectedNodeEl = null;

function resetBrowser() {
  selectedPath = null; selectedNodeEl = null;
  $('curPath').textContent = '—';
  $('valuesBody').innerHTML = '<div class="empty">Sélectionne une clé pour voir ses valeurs.</div>';
  $('newValBtn').disabled = $('newKeyBtn').disabled = $('delKeyBtn').disabled = true;
}

function renderRoots() {
  $('tree').innerHTML = ROOTS.map(function (r) { return nodeHtml(r, r, true); }).join('');
  bindTree();
}

function nodeHtml(path, label, hasChildren) {
  return '<div class="node" data-path="' + escapeHtml(path) + '">'
       +   '<span class="label">'
       +     '<span class="twist">' + (hasChildren ? '▸' : ' ') + '</span>'
       +     escapeHtml(label)
       +   '</span>'
       +   '<div class="children"></div>'
       + '</div>';
}

function bindTree() {
  [].slice.call(document.querySelectorAll('#tree .node > .label')).forEach(function (lab) {
    if (lab._bound) return; lab._bound = true;
    lab.onclick = function (ev) {
      ev.stopPropagation();
      var node = lab.parentNode;
      var path = node.getAttribute('data-path');
      selectKey(path, node);
      toggleNode(node);
    };
  });
}

function toggleNode(node) {
  var path = node.getAttribute('data-path');
  var children = node.querySelector('.children');
  var twist = node.querySelector('.twist');
  if (children.dataset.loaded === 'open') {
    children.dataset.loaded = 'closed';
    children.style.display = 'none';
    twist.textContent = '▸';
    return;
  }
  if (children.dataset.loaded === 'closed') {
    children.style.display = '';
    children.dataset.loaded = 'open';
    twist.textContent = '▾';
    return;
  }
  twist.textContent = '⋯';
  callAgent('enumKeys', { nodeId: activeNodeId, path: path }).then(function (data) {
    var keys = (data && data.keys) || [];
    children.innerHTML = keys.map(function (k) { return nodeHtml(path + '\\' + k, k, true); }).join('') ||
                          '<div style="color:#aaa;padding-left:14px;font-style:italic;font-size:11px">(vide)</div>';
    children.dataset.loaded = 'open';
    children.style.display = '';
    twist.textContent = keys.length ? '▾' : '·';
    bindTree();
  }).catch(function (e) {
    children.innerHTML = '<div class="err">' + escapeHtml(e.message) + '</div>';
    children.dataset.loaded = 'open';
    children.style.display = '';
    twist.textContent = '!';
  });
}

function selectKey(path, nodeEl) {
  selectedPath = path;
  if (selectedNodeEl) selectedNodeEl.classList.remove('selected');
  selectedNodeEl = nodeEl;
  if (nodeEl) nodeEl.classList.add('selected');
  $('curPath').textContent = path;
  $('newValBtn').disabled = false;
  $('newKeyBtn').disabled = false;
  $('delKeyBtn').disabled = (ROOTS.indexOf(path) !== -1);
  loadValues(path);
}

function loadValues(path) {
  $('valuesBody').innerHTML = '<div class="empty">Chargement…</div>';
  callAgent('enumValues', { nodeId: activeNodeId, path: path }).then(function (data) {
    var vals = (data && data.values) || [];
    if (!vals.length) { $('valuesBody').innerHTML = '<div class="empty">Aucune valeur.</div>'; return; }
    var rows = vals.map(function (v) {
      var dataStr = (v.type === 'MultiString' && Array.isArray(v.data)) ? v.data.join(' | ') : String(v.data == null ? '' : v.data);
      return '<tr class="row" data-name="' + escapeHtml(v.name) + '">'
           +   '<td>' + (v.name || '<i>(Par défaut)</i>') + '</td>'
           +   '<td><span class="badge">' + escapeHtml(v.type) + '</span></td>'
           +   '<td class="data">' + escapeHtml(dataStr.slice(0, 200)) + (dataStr.length > 200 ? '…' : '') + '</td>'
           +   '<td style="white-space:nowrap">'
           +     '<button data-act="edit" data-name="' + escapeHtml(v.name) + '">Éditer</button> '
           +     '<button class="danger" data-act="del" data-name="' + escapeHtml(v.name) + '">×</button>'
           +   '</td>'
           + '</tr>';
    }).join('');
    $('valuesBody').innerHTML = '<table><thead><tr><th>Nom</th><th>Type</th><th>Valeur</th><th></th></tr></thead><tbody>' + rows + '</tbody></table>';
    [].slice.call($('valuesBody').querySelectorAll('button[data-act]')).forEach(function (b) {
      b.onclick = function (ev) {
        ev.stopPropagation();
        var act = b.getAttribute('data-act');
        var nm = b.getAttribute('data-name');
        if (act === 'edit') editValue(nm, vals.find(function (x) { return x.name === nm; }));
        else if (act === 'del') deleteValue(nm);
      };
    });
  }).catch(function (e) {
    $('valuesBody').innerHTML = '<div class="err">' + escapeHtml(e.message) + '</div>';
  });
}

// --- Batch (multi-cible) --------------------------------------------------

function targetNodes() {
  // Si des cases sont cochées, on les utilise. Sinon on retombe sur le poste actif.
  var ids = Object.keys(checkedNodes);
  if (!ids.length && activeNodeId) ids = [activeNodeId];
  return ids;
}

function batchDispatch(action, makeBody, label) {
  var ids = targetNodes();
  if (!ids.length) return alert('Aucun poste cible.');
  if (ids.length > 1 && !confirm(label + '\nAppliquer sur ' + ids.length + ' postes ?')) return;
  // Modale de progression.
  var bg = showModal([
    '<h3>' + escapeHtml(label) + ' — ' + ids.length + ' poste' + (ids.length > 1 ? 's' : '') + '</h3>',
    '<div id="bRes" class="batchResults"></div>',
    '<div class="actions"><button id="bClose" disabled>Fermer</button></div>',
  ].join(''));
  var resBox = bg.querySelector('#bRes');
  var btnClose = bg.querySelector('#bClose');
  btnClose.onclick = function () { closeModal(bg); };
  var nameById = {};
  agents.forEach(function (a) { nameById[a.id] = a.name; });

  // Dispatch séquentiel (les opérations registre sont rapides ; en parallèle
  // ça monopoliserait trop d'execFile côté serveur MC).
  var i = 0;
  var ok = 0, ko = 0;
  function next() {
    if (i >= ids.length) {
      resBox.innerHTML += '\n<div><b>Terminé : ' + ok + ' OK, ' + ko + ' KO</b></div>';
      btnClose.disabled = false;
      // Recharge la vue si pertinent.
      if (selectedPath) loadValues(selectedPath);
      return;
    }
    var id = ids[i++];
    var body = makeBody(id);
    resBox.innerHTML += '<div>• ' + escapeHtml(nameById[id] || id) + ' … </div>';
    resBox.scrollTop = resBox.scrollHeight;
    callAgent(action, body).then(function () {
      ok++;
      resBox.lastChild.innerHTML += '<span class="ok">OK</span>';
      next();
    }).catch(function (e) {
      ko++;
      resBox.lastChild.innerHTML += '<span class="ko">KO — ' + escapeHtml(e.message) + '</span>';
      next();
    });
  }
  next();
}

// --- Editeur valeur -------------------------------------------------------

function showModal(html) {
  var bg = document.createElement('div'); bg.className = 'modalBg';
  bg.innerHTML = '<div class="modal">' + html + '</div>';
  document.body.appendChild(bg);
  bg.onclick = function (e) { if (e.target === bg) document.body.removeChild(bg); };
  return bg;
}
function closeModal(bg) { try { document.body.removeChild(bg); } catch (e) {} }

var TYPES = ['String', 'ExpandString', 'DWord', 'QWord', 'Binary', 'MultiString'];

function editValue(name, existing) {
  var isNew = !existing;
  var v = existing || { name: name || '', type: 'String', data: '' };
  var typeOpts = TYPES.map(function (t) {
    return '<option value="' + t + '"' + (t === v.type ? ' selected' : '') + '>' + t + '</option>';
  }).join('');
  var dataStr = Array.isArray(v.data) ? v.data.join('\n') : String(v.data == null ? '' : v.data);
  var nIds = targetNodes().length;
  var bg = showModal([
    '<h3>' + (isNew ? 'Nouvelle valeur' : 'Éditer ' + escapeHtml(v.name)) + (nIds > 1 ? ' (' + nIds + ' postes)' : '') + '</h3>',
    '<label>Nom</label>',
    '<input id="evName" value="' + escapeHtml(v.name) + '"' + (isNew ? '' : ' disabled') + '>',
    '<label>Type</label>',
    '<select id="evType">' + typeOpts + '</select>',
    '<label id="evDataLabel">Donnée</label>',
    '<textarea id="evData">' + escapeHtml(dataStr) + '</textarea>',
    '<div class="actions">',
    '  <button id="evCancel">Annuler</button>',
    '  <button id="evSave">Enregistrer</button>',
    '</div>',
  ].join(''));
  var updateHint = function () {
    var t = bg.querySelector('#evType').value;
    var label = bg.querySelector('#evDataLabel');
    if (t === 'DWord' || t === 'QWord') label.textContent = 'Donnée (entier)';
    else if (t === 'Binary') label.textContent = 'Donnée (hexa, ex: DE AD BE EF)';
    else if (t === 'MultiString') label.textContent = 'Donnée (une ligne = une entrée)';
    else label.textContent = 'Donnée';
  };
  bg.querySelector('#evType').onchange = updateHint;
  updateHint();
  bg.querySelector('#evCancel').onclick = function () { closeModal(bg); };
  bg.querySelector('#evSave').onclick = function () {
    var name = bg.querySelector('#evName').value;
    var type = bg.querySelector('#evType').value;
    var data = bg.querySelector('#evData').value;
    closeModal(bg);
    batchDispatch('writeValue', function (nodeId) {
      return { nodeId: nodeId, path: selectedPath, name: name, type: type, data: data };
    }, 'Écrire ' + name);
  };
}

function deleteValue(name) {
  batchDispatch('deleteValue', function (nodeId) {
    return { nodeId: nodeId, path: selectedPath, name: name };
  }, 'Supprimer la valeur ' + name);
}

function createKey() {
  var sub = prompt('Nom de la sous-clé à créer sous\n' + selectedPath);
  if (!sub) return;
  batchDispatch('createKey', function (nodeId) {
    return { nodeId: nodeId, path: selectedPath + '\\' + sub };
  }, 'Créer la clé ' + sub);
  // Recharge l'arbre courant après pour le poste actif.
  setTimeout(function () {
    if (selectedNodeEl && activeNodeId) {
      var children = selectedNodeEl.querySelector('.children');
      children.dataset.loaded = ''; children.innerHTML = '';
      toggleNode(selectedNodeEl);
    }
  }, 800);
}

function deleteCurrentKey() {
  batchDispatch('deleteKey', function (nodeId) {
    return { nodeId: nodeId, path: selectedPath };
  }, 'Supprimer la clé ' + selectedPath);
}

$('refreshTree').onclick = function () { if (activeNodeId) renderRoots(); };
$('newValBtn').onclick = function () { if (selectedPath) editValue('', null); };
$('newKeyBtn').onclick = function () { if (selectedPath) createKey(); };
$('delKeyBtn').onclick = function () { if (selectedPath) deleteCurrentKey(); };

loadAgents();
</script>

</body>
</html>
